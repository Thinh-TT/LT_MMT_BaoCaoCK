*.dat
*.tmp
*.log
src/nhanh1/benchmark_temp.txt
src/nhanh1/*_copy.txt
src/nhanh2/*.dat
src/nhanh2/*_test_copy.txt
src/nhanh2/*_out.dat

# --- 7. Operating System Files ---
