*.class
*.jar
*.war
*.ear
out/
bin/
build/
dist/

# --- 2. NetBeans IDE ---
nbproject/private/
nbproject/Makefile-*.mk
nbproject/Package-*.bash
nbproject/*.bak

# --- 3. IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- 4. Visual Studio Code ---
.vscode/
*.code-workspace

# --- 5. Eclipse IDE ---
.settings/
.project
.classpath

# --- 6. Temporary Benchmark & Test Files (Generated in Nhánh 1, 2, 3...) ---
